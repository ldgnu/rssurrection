# --- FreshRSS (obligatorio) ---------------------------------------------
# Acepta el host, un subpath o la URL completa del API.
FRESHRSS_BASE_URL=https://rss.example.com
FRESHRSS_USER=your-user
# Contraseña de API (Perfil -> API en FreshRSS), NO la del login.
FRESHRSS_API_PASSWORD=change-me

# --- Servidor ------------------------------------------------------------
RSSURRECTION_LISTEN_ADDR=:8080
RSSURRECTION_LOG_LEVEL=info
RSSURRECTION_SHUTDOWN_TIMEOUT=10s

# --- FreshRSS: ajustes finos --------------------------------------------
FRESHRSS_TIMEOUT=10s
FRESHRSS_MAX_RESPONSE_BYTES=8388608
# Solo para desarrollo contra un FreshRSS en http dentro de una red confiable.
RSSURRECTION_ALLOW_INSECURE_FRESHRSS=false

# --- Resumen con IA (opcional) ------------------------------------------
# Compatible con cualquier endpoint OpenAI. Si falta la clave, no se muestra.
RSSURRECTION_AI_BASE_URL=https://opencode.ai/zen/v1
RSSURRECTION_AI_MODEL=deepseek-v4.1-flash
RSSURRECTION_AI_API_KEY=
RSSURRECTION_AI_TIMEOUT=30s

# --- Noticias regionales (opcional) -------------------------------------
# "Nombre|URL,Nombre|URL". Usá "none" para desactivarlas.
RSSURRECTION_REGIONAL_FEEDS=
RSSURRECTION_REGIONAL_LIMIT=12
